# ═════════════════════════════════════════════════════════════════
#  Настройки КОНКРЕТНОГО киоска.
#
#  Положить как:  C:\PrintKiosk\config\application.yml
#
#  Именно config\ рядом с jar — Spring Boot читает эту папку
#  автоматически и её значения перекрывают то, что вшито внутрь jar.
#  Пересобирать приложение не нужно, IntelliJ не нужен: обычный
#  текстовый файл, правится Блокнотом.
#
#  ВАЖНО: сохранять в UTF-8. Блокнот в старых версиях Windows пишет
#  ANSI, и русские названия принтера превратятся в кракозябры.
#  В Блокноте: Файл → Сохранить как → Кодировка: UTF-8.
#
#  Здесь указывают ТОЛЬКО то, что отличается от значений по умолчанию.
#  Всё остальное подхватится из jar.
# ═════════════════════════════════════════════════════════════════

kiosk:
  server:
    # Куда киоск ходит за данными.
    base-url: https://ваш-домен.kg

    # Ссылку для QR загрузки киоск берёт с сервера (её строит сервер из
    # PUBLIC_BASE_URL), так что отдельно настраивать её на каждом киоске
    # не нужно. Этот адрес — только запасной, пока сервер не ответил.
    # Обычно совпадает с base-url; строку можно вообще не писать.
    public-base-url: https://ваш-домен.kg

    # ID из админки — под ним точка отображается в списке терминалов.
    kiosk-id: vostok-5

    # Ключ выдаётся ОДИН РАЗ при создании киоска в админке.
    # Потеряли — нажмите «Перевыпустить ключ» и впишите новый.
    api-key: 9_MUAtl2qkD987eCGs7n_oBW2KLSsngZl-N1ktl3wd8

  printer:
    # Точное имя из «Устройства и принтеры».
    name: Canon MF232w
    # IP принтера для опроса уровней бумаги и тонера по SNMP.
    # Пусто = только драйвер, без телеметрии расходников.
    snmp-host: 192.168.1.154

  scanner:
    mock: false
    # Точное имя устройства из WIA. Пусто = первый найденный сканер.
    device-name: Canon MF230 ser_A8E291D1B261

  branding:
    # Логотип на главном экране. Положите PNG рядом и укажите путь.
    # Высота на экране — 340 px, ширина подгоняется по пропорции;
    # исходник лучше брать от 700 px по высоте, иначе будет мылить.
    # Файла нет — блок логотипа просто не показывается.
    logo-path: C:/PrintKiosk/config/logo.png

  # Дистанционные команды из админки (перезагрузка).
  commands:
    enabled: true
