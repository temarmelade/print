# Заголовки для Spring за Cloudflare Tunnel.
#
# Настоящий адрес клиента Cloudflare кладёт в CF-Connecting-IP.
# Схему всегда считаем https: до Cloudflare клиент идёт по TLS, и без
# этого приложение построило бы ссылки в QR-кодах с http://.
proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $client_ip;
proxy_set_header X-Forwarded-For   $client_ip;
proxy_set_header X-Forwarded-Proto https;
proxy_set_header X-Forwarded-Host  $host;
proxy_http_version 1.1;
