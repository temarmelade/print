# Базовый префикс API (в dev проксируется на Spring через vite.config.ts)
VITE_API_BASE_URL=/api

# Куда проксировать /api в dev-режиме
VITE_API_PROXY=http://localhost:8080

# Вход через реальный бэкенд (сервер должен быть запущен).
# Поставь true, чтобы работать над UI без сервера (демо-аккаунты в authApi.ts).
VITE_USE_MOCK_AUTH=false
