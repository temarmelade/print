# Базовый префикс API (в dev проксируется на Spring через vite.config.ts)
VITE_API_BASE_URL=/api

# Куда проксировать /api в dev-режиме
VITE_API_PROXY=http://localhost:8080

# true — вход работает на заглушке (без бэкенда), удобно на старте.
# Демо-аккаунты: owner/owner123, tech/tech123, support/support123
# Переключить в false, когда поднимете серверную авторизацию.
VITE_USE_MOCK_AUTH=true
