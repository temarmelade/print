# Прод-сборка админки.
# Заглушка входа выключена: в production-сборке она вырезается
# принудительно, но флаг оставлен явным ради читаемости.
VITE_USE_MOCK_AUTH=false
# Пусто = запросы идут на тот же домен, откуда открыта админка,
# и Nginx проксирует /api на сервер. Отдельный адрес не нужен.
VITE_API_BASE_URL=/api
