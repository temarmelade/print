spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/kiosk
    username: kiosk
    password: kiosk

kiosk:
  storage:
    path: /tmp/kiosk-uploads
    # localhost здесь можно оставить: ссылки для телефона (QR загрузки и
    # получения сканов) сервер тогда строит по IP этой машины в сети —
    # адрес пишется в лог при старте. Если определился не тот адаптер,
    # впишите IP явно, например http://192.168.1.57:8080
    public-base-url: http://localhost:8080

finik:
  api-key: local-mock-key