# ═════════════════════════════════════════════════════════════════
#  Боевые настройки. Скопировать в .env.prod и заполнить.
#  .env.prod НЕ коммитить — он уже в .gitignore.
#
#  Секреты генерировать так:
#      openssl rand -base64 48
# ═════════════════════════════════════════════════════════════════

# ── Домен ──
# Тот же адрес используется для CORS админки и для ссылок в QR-кодах.
PUBLIC_BASE_URL=https://kioskprint.kg

# ── База данных ──
DB_NAME=kiosk
DB_USER=kiosk
DB_PASSWORD=

# ── Админка ──
# Минимум 32 символа. НЕ значение из репозитория.
ADMIN_JWT_SECRET=
ADMIN_OWNER_USERNAME=owner
# Первый владелец создаётся при пустой таблице. Смените пароль
# в интерфейсе сразу после первого входа.
ADMIN_OWNER_PASSWORD=

# ── Оплата Bakai ──
BAKAI_ENABLED=false
BAKAI_LOGIN=
BAKAI_PASSWORD=
BAKAI_ACCOUNT_NO=
# Значение выдаёт банк. Без него оплата создаётся, но НЕ подтверждается.
BAKAI_QR_TYPE=

# ── Telegram ──
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Имя бота без @. Из него строится ссылка в QR-коде загрузки файлов —
# при несовпадении человек попадёт на чужого или несуществующего бота.
TELEGRAM_BOT_USERNAME=PrintKioskBot
TELEGRAM_ALERTS_TOKEN=
